.movie-night-panel {
  background-color: rgba(10, 10, 14, 0.75);
  border-radius: 12px;
  padding: 10px 14px;
  align-items: center;
  max-width: 320px;
}

.countdown {
  font-size: 16px;
  color: #ffd35c;
  -unity-font-style: bold;
  margin-bottom: 4px;
}

.movie-title {
  font-size: 14px;
  color: #eceef2;
}