# Copy this file to .env and adjust. Never commit real secrets.
PORT=8080
# SQLite database file (created automatically)
DB_PATH=./data.db
# Set to 1 while developing: /api/recover returns the reset token in the
# response (no mail server configured). Set to 0 for any real deployment
# and wire an email provider in auth.js -> createResetToken().
RESET_DEV=1
# Optional: comma-separated list of extra allowed movie file extensions
MEDIA_EXT=.mp4,.webm,.m4v
